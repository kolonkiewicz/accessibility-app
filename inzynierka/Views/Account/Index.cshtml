@model UserModel

@{
    ViewData["Title"] = "Twoje Konto";

    // generowanie pseudo-hasła
    string randompass = "";
    Random r = new Random();
    int len = r.Next(6, 12);
    randompass = new string('*', len);
}

<div class="d-flex justify-content-center mt-5">
    <div class="account-box p-4 shadow-sm rounded">

        <h1 class="text-center mb-4 fw-bold">Twoje Konto</h1>

        <div class="row">
            <!-- LEWA KOLUMNA -->
            <div class="col-md-6">

                <!-- LOGIN -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Login:</label>
                    <div class="input-wrapper">
                        <i class="fa-solid fa-user input-icon"></i>
                        <input asp-for="Username" class="form-control ps-5 bg-light" readonly />
                    </div>
                </div>

                <!-- EMAIL -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Adres e-mail:</label>
                    <div class="input-wrapper">
                        <i class="fa-solid fa-envelope input-icon"></i>
                        <input asp-for="Email" class="form-control ps-5 bg-light" readonly />
                    </div>
                </div>

                <!-- HASLO -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Hasło:</label>
                    <div class="input-wrapper">
                        <i class="fa-solid fa-lock input-icon"></i>
                        <input value="@randompass" class="form-control ps-5 bg-light" readonly />
                    </div>
                </div>

            </div>

            <!-- PRAWA KOLUMNA -->
            <div class="col-md-6">

                <!-- IMIE -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Imię:</label>
                    <div class="input-wrapper">
                        <i class="fa-solid fa-user input-icon"></i>
                        <input asp-for="Name" class="form-control ps-5 bg-light" readonly />
                    </div>
                </div>

                <!-- NAZWISKO -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Nazwisko:</label>
                    <div class="input-wrapper">
                        <i class="fa-solid fa-user input-icon"></i>
                        <input asp-for="Surname" class="form-control ps-5 bg-light" readonly />
                    </div>
                </div>

                <!-- ZMIANA HASLA -->
                <div class="mt-4">
                    <form asp-controller="Home" asp-action="GoToChangePassword">
                        <button type="submit" class="btn btn-primary w-100 py-2">Zmień hasło</button>
                    </form>
                </div>

            </div>
        </div>

        <!-- WYLOGOWANIE -->
        <div class="mt-4 text-center">
            <form asp-controller="Account" asp-action="Logout">
                <button type="submit" class="btn btn-outline-primary btn-lg w-100">
                    Wyloguj się
                </button>
            </form>
        </div>

    </div>
</div>

<style>
    .account-box {
        width: 100%;
        max-width: 700px;
        background: #fff;
    }

    .input-wrapper {
        position: relative;
    }

    .input-icon {
        position: absolute;
        top: 50%;
        left: 12px;
        transform: translateY(-50%);
        color: #555;
        font-size: 17px;
    }

    .form-control {
        height: 48px;
        font-size: 16px;
    }
</style>
