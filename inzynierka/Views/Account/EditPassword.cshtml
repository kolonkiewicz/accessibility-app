@model inzynierka.Models.UserModel

@{
    ViewData["Title"] = "Zmień hasło";
}

<div class="d-flex justify-content-center mt-5">
    <div class="account-box p-4 shadow-sm rounded">

        <h1 class="text-center mb-4 fw-bold">Zmień hasło</h1>

        <form asp-controller="Account" asp-action="SubmitChangePassword" method="post">

            <!-- NOWE HASŁO -->
            <div class="mb-3">
                <div class="input-wrapper">
                    <i class="fa-solid fa-lock input-icon"></i>
                    <input type="password" class="form-control ps-5" name="Password" placeholder="Podaj nowe hasło">
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <!-- POWTÓRZ HASŁO -->
            <div class="mb-4">
                <div class="input-wrapper">
                    <i class="fa-solid fa-lock input-icon"></i>
                    <input type="password" class="form-control ps-5" name="Ppassword" placeholder="Powtórz nowe hasło">
                </div>
                <span asp-validation-for="Ppassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100">Zmień hasło</button>
        </form>

        <div class="text-center mt-4">
            <form asp-controller="Home" asp-action="GoToAccount">
                <button type="submit" class="btn btn-outline-primary btn-lg w-100">
                    Powrót do szczegółów konta
                </button>
            </form>
        </div>

    </div>
</div>

<style>
    .account-box {
        width: 100%;
        max-width: 500px;
        background: #fff;
    }

    .input-wrapper {
        position: relative;
    }

    .input-icon {
        position: absolute;
        top: 50%;
        left: 12px;
        transform: translateY(-50%);
        color: #444;
        font-size: 18px;
    }

    .form-control {
        height: 48px;
        font-size: 16px;
    }
</style>
