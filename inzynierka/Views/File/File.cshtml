@{
    ViewData["Title"] = "Lista raportów";
}

<h1 class="mb-4">Lista twoich raportów</h1>

<div class="text-muted fst-italic mt-4" style="font-size: 1.1rem;">
    Brak raportów do wyświetlenia
</div>

@*if (Model == null || !Model.Any())
{
    <div class="text-muted fst-italic mt-4" style="font-size: 1.1rem;">
        Brak raportów do wyświetlenia
    </div>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>URL</th>
                <th>Użytkownik</th>
                <th>Liczba błędów</th>
                <th>Data skanu</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var report in Model)
            {
                <tr>
                    <td>@report.Id</td>
                    <td>@report.Url</td>
                    <td>@report.UserName</td>
                    <td>
                        @if (report.ViolationCount == 0)
                        {
                            <span class="text-success fw-semibold">Brak błędów</span>
                        }
                        else
                        {
                            <span class="text-danger fw-semibold">@report.ViolationCount</span>
                        }
                    </td>
                    <td>@report.ScanDate.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                        <a asp-controller="Reports" asp-action="Details" asp-route-id="@report.Id" class="btn btn-sm btn-outline-primary">
                            Szczegóły
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>*@
