@{
    ViewData["Title"] = "Sprawdź dostępność strony";
}

<div class="container mt-5">
    <h1 class="mb-4 text-center">Analiza dostępności strony (WCAG 2.1)</h1>

    <form asp-action="Scan" method="post" class="d-flex justify-content-center">
        <input type="text" name="url" class="form-control w-50" placeholder="https://example.com" required />
        <button type="submit" class="btn btn-success ms-2">Skanuj</button>
    </form>
</div>