@model inzynierka.Models.ViewModels.ScanResultViewModel

<h2>Wyniki skanu: @Model.Url</h2>
<p>Data skanu: @Model.Date</p>

@if (!Model.Violations.Any())
{
    <p style="color: green;">Brak błędów 🟢</p>
}
else
{
    <h3>Znalezione błędy:</h3>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Rule</th>
                <th>Impact</th>
                <th>Opis</th>
                <th>Selector</th>
                <th>HTML</th>
                <th>Pomoc</th>
                <th>Rekomendacja</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Violations)
            {
                <tr>
                    <td>@item.Violation.RuleId</td>
                    <td>@item.Violation.Impact</td>
                    <td>@item.Violation.Description</td>
                    <td>@item.Violation.Selector</td>
                    <td><code>@item.Violation.Html</code></td>
                    <td><a href="@item.Violation.Help" target="_blank">Wskazówki</a></td>
                    <td style="color: darkgreen; font-weight: bold;">
                        @item.Suggestion
                    </td>
                </tr>
            }
        </tbody>
    </table>

}
