@model IEnumerable<inzynierka.Models.ViewModels.ReportListItemViewModel>

<div class="container my-5">

    <div class="text-center mb-4">
        <h1 class="fw-bold">Twoje raporty</h1>
        <p class="text-muted">Lista wszystkich wykonanych przez ciebie analiz dostępności</p>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-4 fs-5 shadow-sm">
            Brak raportów dla tego użytkownika.
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-hover table-bordered align-middle">
                <thead class="table-light">
                    <tr class="text-center">
                        <th style="width: 45%;">Adres URL</th>
                        <th>Data skanu</th>
                        <th>Liczba błędów</th>
                        <th style="width: 140px;">Akcje</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var report in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@report.Url</td>

                            <td class="text-center">
                                @report.ScanDate.ToString("yyyy-MM-dd HH:mm")
                            </td>

                            <td class="text-center">
                                <span class="badge
                                    @(report.ErrorCount == 0 ? "bg-success" :
                                      report.ErrorCount < 10 ? "bg-warning" : "bg-danger")"
                                      style="font-size: 14px;">
                                    @report.ErrorCount
                                </span>
                            </td>

                            <td class="text-center">
                                <div class="btn-group d-flex justify-content-center gap-2" role="group">
                                    <a class="btn btn-outline-primary btn-sm px-3 "
                               asp-controller="Reports"
                               asp-action="Declaration"
                               asp-route-id="@report.ScanId">
                                        <i class="fa-solid fa-file-signature me-1"></i> Deklaracja
                                    </a>

                                    <a class="btn btn-primary btn-sm px-3"
                               asp-controller="Home"
                               asp-action="ScanDetails"
                               asp-route-id="@report.ScanId">
                                        <i class="fa-solid fa-magnifying-glass-chart me-1"></i> Szczegóły
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
