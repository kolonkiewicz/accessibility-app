@model UserModel

@{
    ViewData["Title"] = "Register";
}

<div class="register-container d-flex justify-content-center align-items-center">
    <div class="register-box p-4 shadow-sm rounded">

        <h1 class="text-center mb-4 fw-bold">Zarejestruj się</h1>

        <form asp-controller="Register" asp-action="SubmitRegister" method="post">

            <div class="mb-3">
                <div class="input-wrapper">
                    <i class="fa-solid fa-user input-icon"></i>
                    <input type="text" class="form-control ps-5" name="Username" placeholder="Login" />
                </div>
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <div class="input-wrapper">
                    <i class="fa-solid fa-lock input-icon"></i>
                    <input type="password" class="form-control ps-5" name="Password" placeholder="Hasło" />
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <div class="input-wrapper">
                    <i class="fa-solid fa-lock input-icon"></i>
                    <input type="password" class="form-control ps-5" name="Ppassword" placeholder="Powtórz hasło" />
                </div>
                <span asp-validation-for="Ppassword" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <div class="input-wrapper">
                    <i class="fa-solid fa-envelope input-icon"></i>
                    <input type="email" class="form-control ps-5" name="Email" placeholder="Adres e-mail" />
                </div>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <div class="input-wrapper">
                    <i class="fa-solid fa-user input-icon"></i>
                    <input type="text" class="form-control ps-5" name="Name" placeholder="Imię" />
                </div>
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <div class="input-wrapper">
                    <i class="fa-solid fa-user input-icon"></i>
                    <input type="text" class="form-control ps-5" name="Surname" placeholder="Nazwisko" />
                </div>
                <span asp-validation-for="Surname" class="text-danger"></span>
            </div>

            <div class="text-center mb-4">
                <button type="submit" class="btn btn-primary btn-lg w-100 py-2">Zarejestruj się</button>
            </div>

        </form>

        <form asp-controller="Home" asp-action="GoToLogin">
            <button type="submit" class="btn btn-outline-primary w-100 py-2">Powrót do logowania</button>
        </form>

    </div>
</div>

<style>
    .register-container {
        min-height: 75vh;
    }

    .register-box {
        max-width: 450px;
        width: 100%;
        background: #fff;
    }

    .input-wrapper {
        position: relative;
    }

    .input-icon {
        position: absolute;
        top: 50%;
        left: 12px;
        transform: translateY(-50%);
        color: #555;
        font-size: 17px;
    }

    .form-control {
        height: 48px;
        font-size: 16px;
    }
</style>
