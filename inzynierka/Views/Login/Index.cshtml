@model UserModel
@{
    ViewData["Title"] = "Login";
}

<div class="login-container d-flex justify-content-center align-items-center">
    <div class="login-box p-4 shadow-sm rounded">

        <h1 class="text-center mb-4 fw-bold">Zaloguj się</h1>

        
        <form asp-controller="Login" asp-action="SubmitLogin" method="post">

            
            <div class="mb-4">
                <div class="input-wrapper">
                    <i class="fa-solid fa-user input-icon"></i>
                    <input type="text" class="form-control ps-5" name="Username" placeholder="Login" maxlength="20" />
                </div>
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

           
            <div class="mb-4">
                <div class="input-wrapper">
                    <i class="fa-solid fa-lock input-icon"></i>
                    <input type="password" class="form-control ps-5" name="Password" placeholder="Password" maxlength="20" />
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            
            <div class="text-center mb-4">
                <button type="submit" class="btn btn-primary btn-lg w-100 py-2">Zaloguj</button>
            </div>

        </form>

        
        <div class="text-center mt-3">
            <form asp-controller="Home" asp-action="GoToResetPassword" class="mb-3">
                <button type="submit" class="btn btn-outline-primary w-100 py-2">Przypomnij hasło</button>
            </form>

            <form asp-controller="Home" asp-action="GoToRegister">
                <button type="submit" class="btn btn-outline-success w-100 py-2">
                    Nie masz konta? Zarejestruj się!
                </button>
            </form>
        </div>

    </div>
</div>


<style>
    .login-container {
        min-height: 75vh;
    }

    .login-box {
        max-width: 420px;
        width: 100%;
        background: #fff;
    }

    .input-wrapper {
        position: relative;
    }

    .input-icon {
        position: absolute;
        top: 50%;
        left: 12px;
        transform: translateY(-50%);
        color: #555;
        font-size: 17px;
    }

    .form-control {
        height: 48px;
        font-size: 16px;
    }

    .btn-lg {
        font-size: 17px;
    }
</style>
