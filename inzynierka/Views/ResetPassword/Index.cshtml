@model UserModel

@{
    ViewData["Title"] = "ResetPassword";
}

<div>
    <div class="row justify-content-center">
        <div class="col-md-6">
            <form asp-controller="ResetPassword" asp-action="ResetPassword" method="post" class="mt-5 d-flex flex-column justify-content-start align-items-center">
                <h1 class="display-4 text-center mb-3">Przypomnienie hasła</h1>
                <div class="mb-3 w-100">
                    <div class="position-relative">
                        <i class="fa-solid fa-envelope-open faicon"></i>
                        <input type="email" class="form-control inputawesome" name="Email" placeholder="e-mail">
                    </div>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="text-center mb-3">
                    <button type="submit" class="btn btn-primary btn-lg">Zresetuj hasło</button>
                </div>
            </form>
        </div>
    </div>
    <div class="row justify-content-center">
        <div class="col-md-6">
            <form asp-controller="Home" asp-action="GoToLogin" class="text-center mb-3">
                <button type="submit" class="btn btn-outline-primary btn-lg">Wróć do logowania</button>
            </form>
        </div>
    </div>
</div>

